#!/usr/bin/env python3
"""Start the media host with a local folder of music."""

import sys
from pathlib import Path


USAGE = """Usage: ./setup-harbor [MUSIC_FOLDER] [server options]

Run without a folder to choose one at the prompt, or pass a path:
  ./setup-harbor "$HOME/Music"

For a custom catalog location:
  ./setup-harbor "$HOME/Music" --data-dir "$HOME/.local/share/harbor-music"

Run python3 -m harbor_music --help for all server options.
"""


def choose_folder(arguments):
    if arguments and not arguments[0].startswith("-"):
        return arguments.pop(0)
    if not sys.stdin.isatty():
        raise SystemExit("Pass a music folder as the first argument when running without a terminal.")
    default = Path.home() / "Music"
    try:
        return input(f"Music folder [{default}]: ") or str(default)
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("Setup canceled.") from None


def main():
    arguments = sys.argv[1:]
    if "--help" in arguments or "-h" in arguments:
        print(USAGE, end="")
        return
    if sys.version_info < (3, 9):
        raise SystemExit("Install Python 3.11 or later to run Harbor Music.")

    folder = choose_folder(arguments)
    state = Path.home() / ".local" / "share" / "harbor-music"
    sys.dont_write_bytecode = True
    from harbor_music.__main__ import main as serve

    print("Keep this terminal open while Harbor Music runs.", flush=True)
    print("Open the media host controls address shown below.", flush=True)
    serve(["--root", folder, "--data-dir", str(state), *arguments])


if __name__ == "__main__":
    main()
